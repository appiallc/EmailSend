generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactList {
  id        String                @id @default(cuid())
  name      String
  createdAt DateTime              @default(now())
  contacts  Contact[]
  campaigns CampaignContactList[]
}

model Contact {
  id            String      @id @default(cuid())
  contactListId String
  email         String
  firstName     String      @default("")
  lastName      String      @default("")
  company       String      @default("")
  title         String      @default("")
  phone         String      @default("")
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  emailLogs     EmailLog[]

  @@unique([contactListId, email])
  @@index([contactListId])
}

model Campaign {
  id               String                @id @default(cuid())
  name             String
  subject          String
  subjectB         String                @default("")
  abTesting        Boolean               @default(false)
  bodyHtml         String
  followUpSubject  String                @default("")
  followUpBodyHtml String                @default("")
  followUpDays     Int                   @default(7)
  /** Local time-of-day for the default follow-up step (HH:mm). */
  followUpTimeOfDay String               @default("10:00")
  extraFollowUps   Json                  @default("[]")
  status           String                @default("draft") // draft | scheduled | sending | sent | paused
  createdAt        DateTime              @default(now())
  scheduledAt      DateTime?
  sentAt           DateTime?
  emailLogs        EmailLog[]
  contactLists     CampaignContactList[]

  @@index([status, scheduledAt])
}

model CampaignContactList {
  campaignId    String
  contactListId String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)

  @@id([campaignId, contactListId])
}

model EmailLog {
  id             String    @id @default(cuid())
  campaignId     String
  contactId      String
  type           String // initial | followup
  followUpStep   Int       @default(0) // 0 = initial; 1+ = follow-up sequence
  status         String    @default("pending") // pending | sent | failed | opened | clicked | replied | bounced
  trackingId     String    @unique @default(cuid())
  messageId      String?
  error          String?
  subjectVariant String? // A | B when campaign A/B is on
  retryCount     Int       @default(0)
  retryAt        DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  bouncedAt      DateTime?
  bounceReason   String?
  bounceType     String? // HARD_BOUNCE | SOFT_BOUNCE
  followUpDue    DateTime?
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
  @@index([followUpDue])
  @@index([status, retryAt])
}

model Settings {
  id             String  @id @default("default")
  companyName    String  @default("Your Company")
  emailSignature String  @default("")
  smtpHost       String  @default("")
  smtpPort       Int     @default(587)
  smtpSecure     Boolean @default(false)
  smtpUser       String  @default("")
  smtpPass       String  @default("")
  smtpFrom       String  @default("")
  imapHost       String  @default("")
  imapPort       Int     @default(993)
  imapUser       String  @default("")
  imapPass       String  @default("")
  baseUrl        String  @default("http://localhost:3000")
  /** Delay between outbound SMTP sends (ms). 0 = no throttle. */
  sendDelayMs    Int     @default(500)
  /** IANA timezone for schedule/follow-up local times. */
  timezone           String  @default("Asia/Kolkata")
  /** When true, roll sends/follow-ups forward off weekends. */
  businessDaysOnly   Boolean @default(true)
  /** Inclusive local send window start (HH:mm). */
  sendWindowStart    String  @default("09:00")
  /** Exclusive local send window end (HH:mm). */
  sendWindowEnd      String  @default("17:00")
  /** Max successful SMTP sends per calendar day in timezone (0 = unlimited). */
  dailySendLimit     Int     @default(100)
  /** Soft-pause campaign when hard-bounce rate exceeds this percent (0 = off). */
  bouncePausePercent Int     @default(5)
  lastOutboundAt       DateTime?
  lastOutboundError    String     @default("")
  lastReplyCheckAt     DateTime?
  lastReplyCheckError  String     @default("")
}

/** Global do-not-email list (unsubscribe, hard bounce, manual). */
model SuppressedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   @default("unsubscribe") // unsubscribe | hard_bounce | manual
  source    String   @default("") // trackingId or note
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/** Reusable email compose templates. */
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  bodyHtml  String
  kind      String   @default("initial") // initial | followup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}
